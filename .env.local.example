# Salin file ini jadi ".env.local", lalu isi API key asli.
# Bisa sampai 12 key per layanan (GEMINI_API_KEY_1 ... GEMINI_API_KEY_12).
# Sistem akan otomatis rotasi ke key berikutnya kalau satu key kena limit/quota.
# Saat deploy ke Vercel, masukkan variable yang sama di:
# Project Settings -> Environment Variables

GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# ... tambahkan sampai GEMINI_API_KEY_12 sesuai jumlah key yang kamu punya

YOUTUBE_API_KEY_1=
YOUTUBE_API_KEY_2=
YOUTUBE_API_KEY_3=
# ... tambahkan sampai YOUTUBE_API_KEY_12 sesuai jumlah key yang kamu punya

# GitHub API tidak butuh key untuk endpoint public repos, jadi tidak perlu di sini.
